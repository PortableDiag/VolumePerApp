<?xml version="1.0" encoding="utf-8"?>
<!--
    Ocean gradient, corner to corner. The launcher masks this to whatever shape
    the device uses, so it carries no detail near the edges.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF1E3A8A" />
                <item android:offset="0.55" android:color="#FF1D4ED8" />
                <item android:offset="1" android:color="#FF0891B2" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
