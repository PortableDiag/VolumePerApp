<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The palettes themselves are generated (values/palettes.xml). What is
        left here is the manifest theme's Ocean and the semantic colours, which
        deliberately do not follow the palette. Every colour has a values-night
        twin; a fixed palette sets night mode to match its own luminance.
    -->

    <!-- ============================ Ocean (light) ============================ -->
    <!-- The house Ocean (ProjectForge palettes.toml), for the manifest theme
         only; the Activities use the generated Theme.VolumePerApp.Ocean. -->
    <color name="brand">#3F66C9</color>
    <color name="brand_soft">#D9E2FF</color>
    <color name="accent">#1E9E93</color>
    <color name="text_on_brand">#FFFFFF</color>
    <color name="bg">#F7F9FE</color>
    <color name="surface">#F7F9FE</color>
    <color name="surface_variant">#E9EEF8</color>
    <color name="text_primary">#171A21</color>
    <color name="text_secondary">#565C6B</color>
    <color name="divider">#9AA2B4</color>

    <!-- ============================== Semantics ============================= -->
    <!-- Status colours are named by meaning, so the mode banner reads the same
         in both schemes and in a screenshot that lost its palette. -->
    <color name="state_ok">#15803D</color>
    <color name="state_ok_bg">#DCFCE7</color>
    <color name="state_warn">#B45309</color>
    <color name="state_warn_bg">#FEF3C7</color>
    <color name="state_bad">#B91C1C</color>
    <color name="state_bad_bg">#FEE2E2</color>

    <color name="playing">#16A34A</color>
    <color name="muted">#94A3B8</color>
    <color name="boost">#C2410C</color>

    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
</resources>
