<?xml version="1.0" encoding="utf-8"?>
<!-- A platform stream (media, ring, alarm...). These work with no permissions
     at all, which is why they stay on screen in Limited mode. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/stream_name"
            android:layout_width="104dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

        <com.google.android.material.slider.Slider
            android:id="@+id/stream_fader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="15"
            app:tickVisible="false" />

        <TextView
            android:id="@+id/stream_readout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.VolumePerApp.Readout" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
